# ============================================
# MOCK MODE CONFIGURATION
# ============================================
USE_MOCK=false
NEXT_PUBLIC_USE_MOCK=false

GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=https://api.x.ai/v1

# ============================================
# CLERK AUTHENTICATION
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ============================================
# DATABASE (NEON POSTGRESQL)
# ============================================
DATABASE_URL=your_postgresql_connection_string

# ============================================
# TEACHING ASSISTANT BACKEND
# ============================================
TEACHING_ASSISTANT_URL=http://127.0.0.1:8000
TEACHING_ASSISTANT_API_KEY=your_ta_api_key

# Teaching Assistant Backend Secrets
API_KEY_SECRET=your_api_key_secret
JWT_SECRET=your_jwt_secret

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_HEAVY=10

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

PORT=8000
HOST=0.0.0.0
ENV=development
DEBUG=true
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

YOUTUBE_API_KEY=your_youtube_api_key